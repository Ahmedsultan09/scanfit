{
  "name": "scanfit-workspace",
  "private": false,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/notices.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/size.mjs",
    "test:independence": "node scripts/independence.mjs",
    "test:consumers": "node scripts/consumers.mjs",
    "test:examples": "node scripts/examples.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:independence && npm run size && npm run test:consumers && npm run test:examples"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webpack": "^5.100.0"
  }
}
