    "./react": {"types":"./dist/types/react/index.d.ts","import":"./dist/react.js"},
    "./trigger": {"types":"./dist/types/trigger/index.d.ts","import":"./dist/trigger.js"},
    "./detector": {"types":"./dist/types/detector/index.d.ts","import":"./dist/detector.js"},
    "./pdf": {"types":"./dist/types/pdf/index.d.ts","import":"./dist/pdf.js"},
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {"react": "^18.2.0 || ^19.0.0"},
  "peerDependenciesMeta": {"react": {"optional": true}},
  "dependencies": {"tinypdf": "0.4.1"}
