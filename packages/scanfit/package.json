{
  "name": "@scanfit/browser",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Local, size-constrained scan-to-PDF workflows for the browser",
  "keywords": [
    "document-scanner",
    "pdf",
    "react",
    "scan-to-pdf",
    "typescript",
    "web-worker"
  ],
  "homepage": "https://scanfit-two.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmedsultan09/scanfit.git",
    "directory": "packages/scanfit"
  },
